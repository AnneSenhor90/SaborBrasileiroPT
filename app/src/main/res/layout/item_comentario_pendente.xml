<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/sabor_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvComentarioRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Restaurante"
            android:textColor="@color/sabor_black_soft"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvComentarioTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Comentário"
            android:textColor="@color/sabor_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAprovarComentario"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:text="Aprovar"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnReprovarComentario"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:backgroundTint="@color/white"
                android:text="Reprovar"
                android:textAllCaps="false"
                android:textColor="@color/sabor_green" />

            <Button
                android:id="@+id/btnMaldosoComentario"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:backgroundTint="@color/white"
                android:text="Maldoso"
                android:textAllCaps="false"
                android:textColor="@color/rating_weak" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
