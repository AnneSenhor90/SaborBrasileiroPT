<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sabor_cream"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button_light"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Adicionar restaurante"
                android:textColor="@color/sabor_black_soft"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/sabor_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Indique um lugar brasileiro"
                    android:textColor="@color/sabor_green"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Preencha os dados principais. Se não for admin master, o restaurante ficará pendente de aprovação."
                    android:textColor="@color/sabor_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etNomeRestaurante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="Nome do restaurante"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sabor_black_soft"
                    android:textColorHint="@color/sabor_text_muted" />

                <EditText
                    android:id="@+id/etCidadeRestaurante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="Cidade, ex: Porto, Matosinhos"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sabor_black_soft"
                    android:textColorHint="@color/sabor_text_muted" />

                <EditText
                    android:id="@+id/etMoradaRestaurante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="Morada completa"
                    android:inputType="textPostalAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sabor_black_soft"
                    android:textColorHint="@color/sabor_text_muted" />

                <EditText
                    android:id="@+id/etCategoriaRestaurante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="Categoria, ex: Churrasco, Açaí, Feijoada"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sabor_black_soft"
                    android:textColorHint="@color/sabor_text_muted" />

                <EditText
                    android:id="@+id/etContactoRestaurante"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="Contacto ou telefone"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sabor_black_soft"
                    android:textColorHint="@color/sabor_text_muted" />

                <EditText
                    android:id="@+id/etLinkImagem"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_field"
                    android:hint="Link da imagem ou logo"
                    android:inputType="textUri"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/sabor_black_soft"
                    android:textColorHint="@color/sabor_text_muted" />

                <EditText
                    android:id="@+id/etDescricaoRestaurante"
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_field"
                    android:gravity="top"
                    android:hint="Descreva o local, pratos principais ou diferencial"
                    android:inputType="textMultiLine"
                    android:maxLength="600"
                    android:padding="14dp"
                    android:textColor="@color/sabor_black_soft"
                    android:textColorHint="@color/sabor_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_field"
            android:fontFamily="sans-serif"
            android:padding="14dp"
            android:text="Dica: quanto mais completa a morada e melhor a imagem, mais fácil será validar e divulgar o restaurante."
            android:textColor="@color/sabor_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSalvarRestaurante"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:fontFamily="sans-serif-medium"
            android:text="Enviar para validação"
            android:textAllCaps="false"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
