<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Novo Restaurante"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etNomeRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do Restaurante"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/etCidadeRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cidade (Ex: Lisboa, Porto)"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/etCategoriaRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Categoria (Ex: Churrascaria, Açaí)"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/etLinkImagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Link da Foto (URL da internet)"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/etDescricaoRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descrição do local"
            android:layout_marginTop="10dp"
            android:inputType="textMultiLine"
            android:lines="3" />

        <Button
            android:id="@+id/btnSalvarRestaurante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar no Banco de Dados"
            android:layout_marginTop="30dp"
            android:backgroundTint="#008800"/> </LinearLayout>
</ScrollView>